---
import { formatRange } from '@/lib/format';
import type { Education } from '@/types';

interface Props {
  item: Education;
}

const { item } = Astro.props;
---

<article class="card education">
  <div class="icon" aria-hidden="true"><i class={item.icon}></i></div>
  <div class="content">
    <header class="head">
      <div>
        <h3>{item.degree}</h3>
        <p class="muted">{item.school} · {item.location}</p>
      </div>
      <p class="dates">{formatRange(item.start, item.end)}</p>
    </header>
    {item.gpa && <p class="gpa">GPA <strong>{item.gpa}</strong></p>}
    {
      item.notes && (
        <ul class="notes">
          {item.notes.map((n) => (
            <li>{n}</li>
          ))}
        </ul>
      )
    }
    {
      item.courses && (
        <>
          <p class="courses-title">Relevant courses</p>
          <ul role="list" class="chips">
            {item.courses.map((c) => (
              <li class="chip">{c}</li>
            ))}
          </ul>
        </>
      )
    }
  </div>
</article>

<style>
  .notes {
    margin-top: var(--space-3);
    padding-inline-start: 1.25rem;
    color: var(--muted);
  }

  .notes li + li {
    margin-top: var(--space-1);
  }

  .education {
    display: flex;
    gap: var(--space-5);
    padding: var(--space-5) var(--space-6);
  }

  .icon {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    color: var(--accent);
    font-size: 1.1rem;
  }

  .content {
    flex: 1;
    min-width: 0;
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
  }

  h3 {
    font-size: var(--fs-lg);
  }

  .dates {
    color: var(--muted);
    font-size: var(--fs-sm);
    font-weight: 500;
  }

  .gpa {
    margin-top: var(--space-3);
  }

  .gpa strong {
    color: var(--accent);
  }

  .courses-title {
    margin-top: var(--space-3);
    margin-bottom: var(--space-2);
    color: var(--muted);
    font-size: var(--fs-sm);
    font-weight: 500;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  @media (max-width: 30rem) {
    .education {
      flex-direction: column;
      gap: var(--space-3);
      padding: var(--space-4);
    }
  }
</style>
