---
import { Image } from 'astro:assets';
import { carousel } from '@/data/skills';
---

<!--
  Logo strip that scrolls continuously and pauses on hover/focus.
  The duplicate list exists only for a seamless loop and is hidden from assistive tech.
-->
<div class="carousel" aria-label="Technologies I work with" role="region">
  <div class="track">
    {
      [0, 1].map((copy) => (
        <ul role="list" class="logos" aria-hidden={copy === 1 ? 'true' : undefined}>
          {carousel.map((tech) => (
            <li title={tech.name}>
              <Image
                src={tech.icon}
                alt={copy === 0 ? tech.name : ''}
                width={40}
                height={40}
                class:list={['logo', { 'invert-dark': tech.invertOnDark }]}
              />
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</div>

<style>
  .carousel {
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, #000 10%, #000 90%, transparent);
  }

  .track {
    display: flex;
    width: max-content;
    animation: scroll 40s linear infinite;
  }

  .carousel:hover .track,
  .carousel:focus-within .track {
    animation-play-state: paused;
  }

  .logos {
    display: flex;
    gap: var(--space-8);
    padding-inline-end: var(--space-8);
  }

  .logo {
    width: 2.5rem;
    height: 2.5rem;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.6;
    transition:
      filter var(--dur) var(--ease),
      opacity var(--dur) var(--ease);
  }

  .logos li:hover .logo {
    filter: none;
    opacity: 1;
  }

  :global([data-theme='dark']) .logo.invert-dark,
  :global([data-theme='dark']) .logos li:hover .logo.invert-dark {
    filter: grayscale(1) invert(1);
  }

  @keyframes scroll {
    to {
      transform: translateX(-50%);
    }
  }

</style>
