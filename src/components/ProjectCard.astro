---
import { Image } from 'astro:assets';
import ProjectLinks from './ProjectLinks.astro';
import { categoryLabels } from '@/data/projects';
import type { Project } from '@/types';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const MAX_CHIPS = 3;
const shownTech = project.tech.slice(0, MAX_CHIPS);
const hiddenCount = project.tech.length - shownTech.length;
const primaryMetric = project.metrics?.[0];
---

<article class="card project-card" data-project data-categories={project.categories.join(' ')}>
  <Image
    src={project.image}
    alt={project.imageAlt}
    width={640}
    height={360}
    class="thumb"
    loading="lazy"
  />
  <div class="content">
    <p class="category">{project.categories.map((c) => categoryLabels[c]).join(' · ')}</p>
    <h3 class="title">
      <button type="button" class="open" data-open-dialog={project.slug} aria-haspopup="dialog">
        {project.title}
      </button>
    </h3>
    <p class="summary">{project.summary}</p>
    {
      primaryMetric && (
        <p class="metric">
          <strong>{primaryMetric.value}</strong> {primaryMetric.label}
        </p>
      )
    }
    <div class="footer">
      <ul role="list" class="chips" aria-label="Tech stack">
        {shownTech.map((t) => <li class="chip">{t}</li>)}
        {
          hiddenCount > 0 && (
            <li class="chip" title={project.tech.slice(MAX_CHIPS).join(', ')}>
              +{hiddenCount}
            </li>
          )
        }
      </ul>
      <ProjectLinks project={project} variant="icons" />
    </div>
  </div>
</article>

<style>
  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition:
      border-color var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }

  .project-card:hover {
    border-color: var(--accent);
    box-shadow: var(--glow);
    transform: translateY(-4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card:hover {
      transform: none;
    }
  }

  .project-card:has(.open:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .thumb {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--surface);
  }

  .content {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-5) var(--space-5);
  }

  .category {
    color: var(--muted);
    font-size: var(--fs-sm);
    font-weight: 500;
  }

  .title {
    font-size: var(--fs-md);
  }

  /* The title button stretches over the whole card so the card is one click target */
  .open {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: start;
  }

  .open:focus-visible {
    outline: none;
  }

  .open::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .summary {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    color: var(--muted);
    font-size: var(--fs-sm);
  }

  .metric {
    font-size: var(--fs-sm);
    color: var(--muted);
  }

  .metric strong {
    color: var(--accent);
    font-size: var(--fs-base);
  }

  .footer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: auto;
    padding-top: var(--space-2);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }
</style>
