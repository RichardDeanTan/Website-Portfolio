---
import { awards, certificates } from '@/data/achievements';
import { formatMonth } from '@/lib/format';

type Row = {
  kind: 'Award' | 'Certificate';
  icon: string;
  title: string;
  issuer: string;
  date: string;
  description: string;
  link?: { label: string; href: string };
  credentialId?: string;
};

const rows: Row[] = [
  ...awards.map((a) => ({
    kind: 'Award' as const,
    icon: 'fa-solid fa-trophy',
    title: a.title,
    issuer: a.issuer,
    date: formatMonth(a.date),
    description: a.description,
    link: a.link,
  })),
  ...certificates.map((c) => ({
    kind: 'Certificate' as const,
    icon: 'fa-solid fa-certificate',
    title: c.title,
    issuer: c.issuer,
    date: formatMonth(c.date),
    description: c.description,
    link: { label: 'View credential', href: c.credentialUrl },
    credentialId: c.credentialId,
  })),
];
---

<!-- Native <details> accordion: keyboard and screen-reader support without JS -->
<ul role="list" class="achievements">
  {
    rows.map((row) => (
      <li>
        <details class="card item">
          <summary>
            <i class:list={[row.icon, 'kind-icon']} aria-hidden="true" />
            <span class="summary-text">
              <span class="title">{row.title}</span>
              <span class="meta">
                <span class="sr-only">{row.kind}: </span>
                {row.issuer} · {row.date}
              </span>
            </span>
            <i class="fa-solid fa-chevron-down chevron" aria-hidden="true" />
          </summary>
          <div class="body">
            <p>{row.description}</p>
            {row.credentialId && <p class="cred-id">Credential ID: {row.credentialId}</p>}
            {row.link && (
              <a href={row.link.href} target="_blank" rel="noopener noreferrer">
                {row.link.label}
                <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true" />
                <span class="sr-only"> (opens in a new tab)</span>
              </a>
            )}
          </div>
        </details>
      </li>
    ))
  }
</ul>

<style>
  .achievements {
    display: grid;
    gap: var(--space-3);
    max-width: 52rem;
    margin-inline: auto;
  }

  summary {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .kind-icon {
    width: 1.25rem;
    color: var(--accent);
    text-align: center;
  }

  .summary-text {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
  }

  .title {
    font-weight: 600;
  }

  .meta {
    color: var(--muted);
    font-size: var(--fs-sm);
  }

  .chevron {
    color: var(--muted);
    transition: transform var(--dur) var(--ease);
  }

  details[open] .chevron {
    transform: rotate(180deg);
  }

  .body {
    padding: 0 var(--space-5) var(--space-5) calc(var(--space-5) + 1.25rem + var(--space-4));
    color: var(--muted);
  }

  .body > * + * {
    margin-top: var(--space-2);
  }

  .body a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 500;
  }

  .body a i {
    font-size: 0.75em;
  }

  .cred-id {
    font-size: var(--fs-sm);
    word-break: break-all;
  }

  @media (max-width: 30rem) {
    .body {
      padding-inline-start: var(--space-5);
    }
  }
</style>
