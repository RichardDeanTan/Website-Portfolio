---
import { profile } from '@/data/profile';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const items = [
  { label: 'LinkedIn', href: profile.links.linkedin, icon: 'fa-brands fa-linkedin-in', external: true },
  { label: 'GitHub', href: profile.links.github, icon: 'fa-brands fa-github', external: true },
  { label: 'WhatsApp', href: profile.links.whatsapp, icon: 'fa-brands fa-whatsapp', external: true },
  { label: 'Email', href: `mailto:${profile.email}`, icon: 'fa-solid fa-envelope', external: false },
];
---

<ul role="list" class:list={['socials', className]}>
  {
    items.map((item) => (
      <li>
        <a
          href={item.href}
          aria-label={item.label}
          title={item.label}
          {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          <i class={item.icon} aria-hidden="true" />
        </a>
      </li>
    ))
  }
</ul>

<style>
  .socials {
    display: flex;
    gap: var(--space-3);
  }

  .socials a {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--border);
    border-radius: 50%;
    color: var(--muted);
    font-size: 1rem;
    text-decoration: none;
    transition:
      color var(--dur) var(--ease),
      border-color var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }

  .socials a:hover,
  .socials a:focus-visible {
    color: var(--accent);
    border-color: var(--accent);
    box-shadow: var(--glow);
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .socials a:hover,
    .socials a:focus-visible {
      transform: none;
    }
  }
</style>
