---
import ExperienceItem from './ExperienceItem.astro';
import EducationCard from './EducationCard.astro';
import { experiences } from '@/data/experience';
import { education } from '@/data/education';
---

<section id="experience">
  <div class="container narrow">
    <h2 class="heading reveal">My <span>Experience</span></h2>

    <ol role="list" class="timeline reveal">
      {experiences.map((item) => <ExperienceItem item={item} />)}
    </ol>

    <h3 class="sub-heading edu-title reveal">My <span>Education</span></h3>
    <ol role="list" class="timeline reveal">
      {
        education.map((item) => (
          <li class:list={['timeline-entry', { 'is-current': item.end === 'present' }]}>
            <span class="timeline-dot" aria-hidden="true" />
            <EducationCard item={item} />
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .narrow {
    max-width: 56rem;
  }

  /* .timeline, .timeline-entry and .timeline-dot are shared styles in global.css */

  .edu-title {
    margin-top: var(--space-8);
    text-align: center;
  }
</style>
